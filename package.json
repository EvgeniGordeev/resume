{
  "name": "evgeni-gordeev-resume",
  "version": "0.0.1",
  "private": true,
  "cacheDirectories": [
    "node_modules"
  ],
  "devDependencies": {
    "bl": "^7.0.3",
    "lodash": "^4.18.1",
    "puppeteer": "^25.1.0",
    "rimraf": "^6.1.3",
    "serve": "^14.2.6"
  },
  "engines": {
    "node": ">24.0"
  },
  "scripts": {
    "clean": "rimraf node_modules/",
    "start": "DEBUG=* serve ./ -l 3001",
    "print": "node scripts/print.js",
    "yaml2json": "yq -o=json resume.yml > resume.json",
    "yaml2md": "pnpm run yaml2json && node scripts/resume2md.js",
    "yaml2doc": "pnpm run yaml2json && python3 scripts/resume2docx.py",
    "yaml2pdf": "pnpm run yaml2doc && soffice --headless --convert-to pdf --outdir downloads downloads/Evgeni_Gordeev_CV.docx",
    "docx-diff": "pnpm run yaml2json && python3 scripts/docx-diff.py"
  },
  "packageManager": "pnpm@10.2.1"
}
