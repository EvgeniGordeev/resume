{
  "name": "evgeni-gordeev-resume",
  "version": "0.0.1",
  "private": true,
  "cacheDirectories": [
    "node_modules"
  ],
  "devDependencies": {
    "bl": "6.1.5",
    "lodash": "4.17.21",
    "puppeteer": "24.31.0",
    "rimraf": "6.1.2",
    "serve": "^14.2.5"
  },
  "packageManager": "pnpm@10.2.1",
  "engines": {
    "node": ">22.0"
  },
  "scripts": {
    "clean": "rimraf node_modules/",
    "start": "DEBUG=* serve ./ -l 3001",
    "print": "node print.js",
    "yaml2json": "yq -o=json resume.yml > resume.json",
    "yaml2md": "npm run yaml2json && node resume2md.js",
    "postinstall": "puppeteer browsers install chrome"
  }
}
