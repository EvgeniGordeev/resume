{
  "name": "evgeni-gordeev-resume",
  "version": "0.0.1",
  "private": true,
  "cacheDirectories": [
    "node_modules"
  ],
  "devDependencies": {
    "bl": "^7.0.3",
    "lodash": "^4.18.1",
    "puppeteer": "^25.1.0",
    "rimraf": "^6.1.3",
    "serve": "^14.2.6"
  },
  "engines": {
    "node": ">24.0"
  },
  "scripts": {
    "clean": "rimraf node_modules/",
    "start": "DEBUG=* serve ./ -l 3001",
    "print": "node print.js",
    "yaml2json": "yq -o=json resume.yml > resume.json",
    "yaml2md": "pnpm run yaml2json && node resume2md.js"
  },
  "packageManager": "pnpm@10.2.1"
}
